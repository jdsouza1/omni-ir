{
  "name": "omni-ir",
  "version": "0.1.0",
  "description": "Omni-IR: a secure, line-oriented streaming protocol for Generative UI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
