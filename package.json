{
  "name": "omni-ir",
  "version": "0.1.0",
  "description": "Omni-IR: a secure, line-oriented streaming protocol for Generative UI",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run guard && vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/guard.mjs",
    "demo": "tsx scripts/demo.tsx",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "validate": "tsx scripts/validate.tsx",
    "prompt:print": "tsx scripts/prompt-print.ts",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
