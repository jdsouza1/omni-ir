    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-whole-or-nothing",
      "rules": [
        "10.32",
        "10.33",
        "10.30"
      ],
      "description": "One failing line rejects the whole update: the good lines before and after it change nothing. Line numbers count from 1 in the update, comments included.",
      "input": "root = Card([status, eta, ret], title=\"Order 1042\")\nstatus = Badge(\"Shipped\")\n$eta = \"Friday\"\neta = Text($eta)\nret = Button(\"Request a return\", action=\"requestReturn\")\nm = McpMutation(ret, tool=\"orders.requestReturn\", params={order: \"1042\"})\n",
      "updates": [
        {
          "input": "# the courier's update\nstatus = Badge(\"Delivered\")\neta = Banner(\"Now\")\n$eta = \"Delivered\"\n",
          "expect": {
            "applied": false,
            "issues": [
              {
                "line": 3,
                "code": "unknown_component"
              }
            ]
          }
        }
      ],
      "expect": {
        "issues": [],
        "nodes": {
          "root": {
            "type": "Card",
            "props": {
              "title": "Order 1042"
            },
            "children": [
              "status",
              "eta",
              "ret"
            ]
          },
          "status": {
            "type": "Badge",
            "props": {
              "text": "Shipped"
            },
            "children": []
          },
          "eta": {
            "type": "Text",
            "props": {
              "text": {
                "state": "$eta"
              }
            },
            "children": []
          },
          "ret": {
            "type": "Button",
            "props": {
              "label": "Request a return",
              "action": "requestReturn"
            },
            "children": []
          }
        },
        "state": {
          "$eta": "Friday"
        }
      }
    },
    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-duplicate-in-update",
      "rules": [
        "10.30",
        "10.33"
      ],
      "description": "One update assigns each id and $key at most once: a second is duplicate_id, and nothing in the update applies.",
      "input": "root = Card([status, eta, ret], title=\"Order 1042\")\nstatus = Badge(\"Shipped\")\n$eta = \"Friday\"\neta = Text($eta)\nret = Button(\"Request a return\", action=\"requestReturn\")\nm = McpMutation(ret, tool=\"orders.requestReturn\", params={order: \"1042\"})\n",
      "updates": [
        {
          "input": "status = Badge(\"Out for delivery\")\n$eta = \"Today\"\nstatus = Badge(\"Delivered\")\n$eta = \"Now\"\n",
          "expect": {
            "applied": false,
            "issues": [
              {
                "line": 3,
                "code": "duplicate_id"
              },
              {
                "line": 4,
                "code": "duplicate_id"
              }
            ]
          }
        }
      ],
      "expect": {
        "issues": [],
        "state": {
          "$eta": "Friday"
        }
      }
    },
