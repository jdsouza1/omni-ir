    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-replace-mutation",
      "rules": [
        "10.30"
      ],
      "description": "An update can replace an McpMutation, checked as any line is: its tool must be registered.",
      "input": "root = Card([status, eta, ret], title=\"Order 1042\")\nstatus = Badge(\"Shipped\")\n$eta = \"Friday\"\neta = Text($eta)\nret = Button(\"Request a return\", action=\"requestReturn\")\nm = McpMutation(ret, tool=\"orders.requestReturn\", params={order: \"1042\"})\n",
      "updates": [
        {
          "input": "m = McpMutation(ret, tool=\"orders.cancel\", params={order: \"1042\"})\n",
          "expect": {
            "applied": false,
            "issues": [
