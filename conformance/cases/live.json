{
  "area": "live",
  "cases": [
    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-replace-component",
      "rules": [
        "10.29",
        "10.30"
      ],
      "description": "After the stream ends, an update's line for an id the screen has replaces that component.",
      "input": "root = Card([status, eta, ret], title=\"Order 1042\")\nstatus = Badge(\"Shipped\")\n$eta = \"Friday\"\neta = Text($eta)\nret = Button(\"Request a return\", action=\"requestReturn\")\nm = McpMutation(ret, tool=\"orders.requestReturn\", params={order: \"1042\"})\n",
      "updates": [
        {
          "input": "status = Badge(\"Out for delivery\", tone=\"success\")\n",
          "expect": {
            "applied": true,
            "issues": []
          }
        }
      ],
      "expect": {
        "issues": [],
        "nodes": {
          "root": {
            "type": "Card",
            "props": {
              "title": "Order 1042"
            },
            "children": [
              "status",
              "eta",
              "ret"
            ]
          },
          "status": {
            "type": "Badge",
            "props": {
              "text": "Out for delivery",
              "tone": "success"
            },
            "children": []
          },
          "eta": {
            "type": "Text",
            "props": {
              "text": {
                "state": "$eta"
              }
            },
            "children": []
          },
          "ret": {
            "type": "Button",
            "props": {
              "label": "Request a return",
              "action": "requestReturn"
            },
            "children": []
          }
        }
      }
    },
