    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-tree-rules-in-order",
      "rules": [
        "10.32",
        "10.33"
      ],
      "description": "The tree rules are checked on the screen the update would leave, with a replaced line in its old place and new lines after: eta can't belong to both root and the new box, and the error is reported on box, the later of the two.",
      "input": "root = Card([status, eta, ret], title=\"Order 1042\")\nstatus = Badge(\"Shipped\")\n$eta = \"Friday\"\neta = Text($eta)\nret = Button(\"Request a return\", action=\"requestReturn\")\nm = McpMutation(ret, tool=\"orders.requestReturn\", params={order: \"1042\"})\n",
      "updates": [
        {
          "input": "root = Card([status, eta, ret, box], title=\"Order 1042\")\nbox = Stack([eta])\n",
          "expect": {
            "applied": false,
            "issues": [
              {
                "line": 2,
                "code": "multiple_parents"
              }
            ]
          }
        }
      ],
      "expect": {
        "issues": []
      }
    },
    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-chart-mismatch",
      "rules": [
        "10.32",
        "10.33"
      ],
      "description": "New labels for a chart without new values for its Series would break [5.23], so the update is rejected; sending both in one update works.",
      "input": "root = BarChart(\"Sales\", [\"9am\", \"10am\"], [s])\ns = Series(\"Orders\", values=[3, 5])\n",
      "updates": [
        {
          "input": "root = BarChart(\"Sales\", [\"9am\", \"10am\", \"11am\"], [s])\n",
          "expect": {
            "applied": false,
            "issues": [
              {
                "line": null,
                "code": "chart_mismatch"
              }
            ]
          }
        },
        {
          "input": "root = BarChart(\"Sales\", [\"9am\", \"10am\", \"11am\"], [s])\ns = Series(\"Orders\", values=[3, 5, 8])\n",
          "expect": {
            "applied": true,
            "issues": []
          }
        }
      ],
      "expect": {
        "issues": [],
        "nodes": {
          "root": {
            "type": "BarChart",
            "props": {
              "title": "Sales",
              "labels": [
                "9am",
                "10am",
                "11am"
              ]
            },
            "children": [
              "s"
            ]
          },
          "s": {
            "type": "Series",
            "props": {
              "name": "Orders",
              "values": [
                3,
                5,
                8
              ]
            },
            "children": []
          }
        }
      }
    },
    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-existing-errors-tolerated",
      "rules": [
        "10.33"
      ],
      "description": "Errors the screen already had don't stop an update: root still lists ghost, which never arrived, and the update applies. If the update supplies ghost, it is no longer missing.",
      "input": "root = Stack([a, ghost])\na = Text(\"Before\")\n",
      "updates": [
        {
          "input": "a = Text(\"After\")\n",
          "expect": {
            "applied": true,
            "issues": []
          }
        },
        {
          "input": "ghost = Text(\"Here now\")\n",
          "expect": {
            "applied": true,
            "issues": []
          }
        }
      ],
      "expect": {
        "issues": [
          {
            "line": 1,
            "code": "dangling_ref"
          }
        ],
        "nodes": {
          "root": {
            "type": "Stack",
            "props": {},
            "children": [
              "a",
              "ghost"
            ]
          },
          "a": {
            "type": "Text",
            "props": {
              "text": "After"
            },
            "children": []
          },
          "ghost": {
            "type": "Text",
            "props": {
              "text": "Here now"
            },
            "children": []
          }
        },
        "missing": []
      }
    },
    {
      "tools": [
        "payments.confirm",
        "orders.requestReturn"
      ],
      "id": "live-field-conflict",
      "rules": [
        "10.34"
      ],
      "description": "An update can't set a $key a field reads: live_field_conflict, and nothing applies.",
