      "input": "root = Card([status, eta, ret], title=\"Order 1042\")\nstatus = Badge(\"Shipped\")\n$eta = \"Friday\"\neta = Text($eta)\nret = Button(\"Request a return\", action=\"requestReturn\")\nm = McpMutation(ret, tool=\"orders.requestReturn\", params={order: \"1042\"})\n",
      "updates": [
        {
          "input": "root = Card([status, done], title=\"Order 1042\")\ndone = Notice(\"Return requested\", tone=\"success\")\n",
          "expect": {
            "applied": true,
            "issues": []
          }
        }
      ],
      "expect": {
        "issues": [],
        "nodes": {
          "root": {
            "type": "Card",
            "props": {
              "title": "Order 1042"
            },
            "children": [
              "status",
              "done"
            ]
          },
          "status": {
            "type": "Badge",
            "props": {
              "text": "Shipped"
            },
            "children": []
          },
          "done": {
            "type": "Notice",
            "props": {
              "text": "Return requested",
              "tone": "success"
            },
            "children": []
          }
        },
        "state": {
          "$eta": "Friday"
        },
        "mutations": {}
