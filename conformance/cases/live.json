      "updates": [
        {
          "input": "tip = Text(\"Out for delivery\")\n$email = \"someone@example.com\"\n",
          "expect": {
            "applied": false,
            "issues": [
              {
                "line": 2,
                "code": "live_field_conflict"
              }
            ]
          }
        }
      ],
      "expect": {
        "issues": [],
        "state": {
          "$email": ""
        },
        "nodes": {
          "root": {
            "type": "Stack",
            "props": {},
            "children": [
              "email",
              "tip"
            ]
          },
          "email": {
            "type": "Input",
            "props": {
              "label": "Email",
              "value": {
                "state": "$email"
              }
            },
            "children": []
          },
          "tip": {
            "type": "Text",
            "props": {
              "text": "Shipped"
            },
            "children": []
          }
        }
      }
    },
