{
  "area": "fields",
  "description": "What a renderer says about a form field's value (SPEC.md section 8, Fields). Generated by npm run conformance:build from conformance/fields.ts.",
  "cases": [
    {
      "id": "input-no-constraints",
      "rules": [
        "8.1"
      ],
      "description": "An Input that declares no constraint passes whatever it holds.",
      "component": "Input",
      "props": {},
      "value": "",
      "expect": null
    },
    {
      "id": "switch-no-constraints",
      "rules": [
        "8.1"
      ],
      "description": "A Switch without required passes when off.",
      "component": "Switch",
      "props": {},
      "value": false,
      "expect": null
    },
    {
      "id": "input-required-empty",
      "rules": [
        "8.2"
      ],
      "description": "A required Input that is empty fails.",
      "component": "Input",
      "props": {
        "required": true
      },
      "value": "",
      "expect": {
        "message": "required"
      }
    },
    {
      "id": "input-required-spaces",
      "rules": [
        "8.2"
      ],
      "description": "White space alone counts as empty.",
      "component": "Input",
      "props": {
        "required": true
      },
      "value": "   \t",
      "expect": {
        "message": "required"
      }
    },
    {
      "id": "input-required-filled",
      "rules": [
        "8.2"
      ],
      "description": "A required Input with text passes.",
      "component": "Input",
      "props": {
        "required": true
      },
      "value": "Ada",
      "expect": null
    },
    {
      "id": "input-required-not-text",
      "rules": [
        "8.2"
      ],
      "description": "A state that doesn't hold text counts as empty.",
      "component": "Input",
      "props": {
        "required": true
      },
      "value": null,
      "expect": {
        "message": "required"
      }
    },
    {
      "id": "date-required-empty",
      "rules": [
        "8.2"
      ],
      "description": "A required DateInput with no date fails.",
      "component": "DateInput",
      "props": {
        "required": true
      },
      "value": "",
      "expect": {
        "message": "required"
      }
    },
    {
      "id": "date-required-filled",
      "rules": [
        "8.2"
      ],
      "description": "A required DateInput with a date passes.",
      "component": "DateInput",
      "props": {
        "required": true
      },
      "value": "2026-10-14",
      "expect": null
    },
    {
      "id": "select-required-none",
      "rules": [
        "8.2"
      ],
      "description": "A required Select with nothing chosen fails with chooseOption.",
      "component": "Select",
      "props": {
        "options": [
          "S",
          "M"
        ],
        "required": true
      },
      "value": "",
      "expect": {
        "message": "chooseOption"
      }
    },
    {
      "id": "select-required-not-an-option",
      "rules": [
        "8.2"
      ],
      "description": "A value that isn't one of the options counts as nothing chosen.",
      "component": "Select",
      "props": {
        "options": [
          "S",
          "M"
        ],
        "required": true
      },
      "value": "XL",
      "expect": {
        "message": "chooseOption"
      }
    },
    {
      "id": "select-required-chosen",
      "rules": [
        "8.2"
      ],
      "description": "A required Select with an option chosen passes.",
      "component": "Select",
      "props": {
        "options": [
          "S",
          "M"
        ],
        "required": true
      },
      "value": "M",
      "expect": null
    },
    {
      "id": "switch-required-off",
      "rules": [
        "8.2"
      ],
      "description": "A required Switch that is off fails with turnOn.",
      "component": "Switch",
      "props": {
        "required": true
      },
      "value": false,
      "expect": {
        "message": "turnOn"
      }
    },
    {
      "id": "switch-required-not-bool",
      "rules": [
        "8.2"
      ],
      "description": "Only true counts as on.",
      "component": "Switch",
      "props": {
        "required": true
      },
      "value": "true",
      "expect": {
        "message": "turnOn"
      }
    },
    {
      "id": "switch-required-on",
      "rules": [
        "8.2"
      ],
      "description": "A required Switch that is on passes.",
      "component": "Switch",
      "props": {
        "required": true
      },
      "value": true,
      "expect": null
    },
    {
      "id": "optional-empty-skips-checks",
      "rules": [
        "8.3"
      ],
      "description": "An empty Input that isn't required passes every other check.",
      "component": "Input",
      "props": {
        "format": "email",
        "minLength": 5
      },
      "value": "  ",
      "expect": null
    },
    {
      "id": "email-valid",
      "rules": [
        "8.3"
      ],
      "description": "An email address with a dot after @ passes.",
      "component": "Input",
      "props": {
        "format": "email"
      },
      "value": "ada@example.com",
      "expect": null
    },
    {
      "id": "email-trimmed",
      "rules": [
        "8.3"
      ],
      "description": "Checks use the value without surrounding white space.",
      "component": "Input",
      "props": {
        "format": "email"
      },
      "value": "  ada@example.co.uk ",
      "expect": null
    },
    {
      "id": "email-no-at",
      "rules": [
        "8.3"
      ],
      "description": "No @ fails.",
      "component": "Input",
      "props": {
        "format": "email"
      },
      "value": "ada.example.com",
      "expect": {
        "message": "invalidEmail"
      }
    },
    {
      "id": "email-no-dot",
      "rules": [
        "8.3"
      ],
      "description": "No dot after @ fails.",
      "component": "Input",
      "props": {
        "format": "email"
      },
      "value": "ada@localhost",
      "expect": {
        "message": "invalidEmail"
      }
    },
    {
      "id": "email-space",
      "rules": [
        "8.3"
      ],
      "description": "A space inside fails.",
      "component": "Input",
      "props": {
        "format": "email"
      },
      "value": "ada lovelace@example.com",
      "expect": {
        "message": "invalidEmail"
      }
    },
    {
      "id": "email-two-at",
      "rules": [
        "8.3"
      ],
      "description": "Two @ fail.",
      "component": "Input",
      "props": {
        "format": "email"
      },
      "value": "ada@@example.com",
      "expect": {
        "message": "invalidEmail"
      }
    },
    {
      "id": "number-valid",
      "rules": [
        "8.3"
      ],
      "description": "Digits with a sign and a decimal part pass, with . or ,.",
      "component": "Input",
      "props": {
        "format": "number"
      },
      "value": "-12.50",
      "expect": null
    },
    {
      "id": "number-comma",
      "rules": [
        "8.3"
      ],
      "description": "A decimal comma passes.",
      "component": "Input",
      "props": {
        "format": "number"
      },
      "value": "3,5",
      "expect": null
    },
    {
      "id": "number-letters",
      "rules": [
        "8.3"
      ],
      "description": "Letters fail.",
      "component": "Input",
      "props": {
        "format": "number"
      },
      "value": "12a",
      "expect": {
        "message": "invalidNumber"
      }
    },
    {
      "id": "number-grouping",
      "rules": [
        "8.3"
      ],
      "description": "Thousands separators fail: one decimal mark only.",
      "component": "Input",
      "props": {
        "format": "number"
      },
      "value": "1,234.5",
      "expect": {
        "message": "invalidNumber"
      }
    },
    {
      "id": "phone-valid",
      "rules": [
        "8.3"
      ],
      "description": "Digits, spaces, brackets, dashes and a leading + pass.",
      "component": "Input",
      "props": {
        "format": "phone"
      },
      "value": "+1 (415) 555-0123",
      "expect": null
    },
    {
      "id": "phone-too-few-digits",
      "rules": [
        "8.3"
      ],
      "description": "Fewer than 7 digits fail.",
      "component": "Input",
      "props": {
        "format": "phone"
      },
      "value": "555-012",
      "expect": {
        "message": "invalidPhone"
      }
    },
    {
      "id": "phone-too-many-digits",
      "rules": [
        "8.3"
      ],
      "description": "More than 15 digits fail.",
      "component": "Input",
      "props": {
        "format": "phone"
      },
      "value": "+1234567890123456",
      "expect": {
        "message": "invalidPhone"
      }
    },
    {
      "id": "phone-plus-inside",
      "rules": [
        "8.3"
      ],
      "description": "A + anywhere but the start fails.",
      "component": "Input",
      "props": {
        "format": "phone"
      },
      "value": "415+5550123",
      "expect": {
        "message": "invalidPhone"
      }
    },
    {
      "id": "phone-letters",
      "rules": [
        "8.3"
      ],
      "description": "Letters fail.",
      "component": "Input",
      "props": {
        "format": "phone"
      },
      "value": "415 555 CALL",
      "expect": {
        "message": "invalidPhone"
      }
    },
    {
      "id": "url-valid",
      "rules": [
        "8.3"
      ],
      "description": "https:// with a host containing a dot passes, with a path.",
      "component": "Input",
      "props": {
        "format": "url"
      },
      "value": "https://example.com/path?q=1",
      "expect": null
    },
    {
      "id": "url-http",
      "rules": [
        "8.3"
      ],
      "description": "http:// passes too.",
      "component": "Input",
      "props": {
        "format": "url"
      },
      "value": "http://shop.example.org",
      "expect": null
    },
    {
      "id": "url-no-scheme",
      "rules": [
        "8.3"
      ],
      "description": "Without http:// or https:// fails.",
      "component": "Input",
      "props": {
        "format": "url"
      },
      "value": "example.com",
      "expect": {
        "message": "invalidUrl"
      }
    },
    {
      "id": "url-other-scheme",
      "rules": [
        "8.3"
      ],
      "description": "Another scheme fails.",
      "component": "Input",
      "props": {
        "format": "url"
      },
      "value": "javascript:alert(1)",
      "expect": {
        "message": "invalidUrl"
      }
    },
    {
      "id": "url-no-dot",
      "rules": [
        "8.3"
      ],
      "description": "A host without a dot fails.",
      "component": "Input",
      "props": {
        "format": "url"
      },
      "value": "https://localhost",
      "expect": {
        "message": "invalidUrl"
      }
    },
    {
      "id": "url-space",
      "rules": [
        "8.3"
      ],
      "description": "A space fails.",
      "component": "Input",
      "props": {
        "format": "url"
      },
      "value": "https://exa mple.com",
      "expect": {
        "message": "invalidUrl"
      }
    },
    {
      "id": "too-short",
      "rules": [
        "8.3"
      ],
      "description": "Fewer code points than minLength fails, with {min}.",
      "component": "Input",
      "props": {
        "minLength": 3
      },
      "value": "ab",
      "expect": {
        "message": "tooShort",
        "values": {
          "min": 3
        }
      }
    },
    {
      "id": "too-long",
      "rules": [
        "8.3"
      ],
      "description": "More code points than maxLength fails, with {max}.",
      "component": "Input",
      "props": {
        "maxLength": 5
      },
      "value": "abcdef",
      "expect": {
        "message": "tooLong",
        "values": {
          "max": 5
        }
      }
    },
    {
      "id": "length-exact",
      "rules": [
        "8.3"
      ],
      "description": "Exactly minLength and maxLength pass.",
      "component": "Input",
      "props": {
        "minLength": 3,
        "maxLength": 3
      },
      "value": "abc",
      "expect": null
    },
    {
      "id": "length-code-points",
      "rules": [
        "8.3"
      ],
      "description": "Lengths count code points: an emoji is one.",
      "component": "Input",
      "props": {
        "maxLength": 3
      },
      "value": "a😀b",
      "expect": null
    },
    {
      "id": "length-trimmed",
      "rules": [
        "8.3"
      ],
      "description": "Lengths count the value without surrounding white space.",
      "component": "Input",
      "props": {
        "maxLength": 3
      },
      "value": "  abc  ",
      "expect": null
    },
    {
      "id": "format-before-length",
      "rules": [
        "8.3"
      ],
      "description": "Checks stop at the first failure, format before length.",
      "component": "Input",
      "props": {
        "format": "email",
        "minLength": 50
      },
      "value": "ada",
      "expect": {
        "message": "invalidEmail"
      }
    },
    {
      "id": "min-before-max",
      "rules": [
        "8.3"
      ],
      "description": "minLength is checked before maxLength.",
      "component": "Input",
      "props": {
        "minLength": 4,
        "maxLength": 10
      },
      "value": "ab",
      "expect": {
        "message": "tooShort",
        "values": {
          "min": 4
        }
      }
    },
    {
      "id": "required-before-format",
      "rules": [
        "8.2",
        "8.3"
      ],
      "description": "required comes first.",
      "component": "Input",
      "props": {
        "required": true,
        "format": "email"
      },
      "value": "",
      "expect": {
        "message": "required"
      }
    },
    {
      "id": "date-too-early",
      "rules": [
        "8.4"
      ],
      "description": "A date before min fails, with {min}.",
      "component": "DateInput",
      "props": {
        "min": "2026-10-14"
      },
      "value": "2026-10-13",
      "expect": {
        "message": "dateTooEarly",
        "values": {
          "min": "2026-10-14"
        }
      }
    },
    {
      "id": "date-too-late",
      "rules": [
        "8.4"
      ],
      "description": "A date after max fails, with {max}.",
      "component": "DateInput",
      "props": {
        "max": "2026-10-31"
      },
      "value": "2026-11-01",
      "expect": {
        "message": "dateTooLate",
        "values": {
          "max": "2026-10-31"
        }
      }
    },
    {
      "id": "date-on-bounds",
      "rules": [
        "8.4"
      ],
      "description": "min and max themselves pass.",
      "component": "DateInput",
      "props": {
        "min": "2026-10-14",
        "max": "2026-10-14"
      },
      "value": "2026-10-14",
      "expect": null
    },
    {
      "id": "date-empty-not-required",
      "rules": [
        "8.4"
      ],
      "description": "An empty DateInput that isn't required passes, whatever min says.",
      "component": "DateInput",
      "props": {
        "min": "2026-10-14"
      },
      "value": "",
      "expect": null
    }
  ]
}
