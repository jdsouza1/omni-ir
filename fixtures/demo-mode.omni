# Omni-IR: shown by the mock model when a prompt matches none of its screens.
root = Card([header, intro, sep, examples, failures])
header = Stack([title, mode], direction="row", gap="sm", align="center")
title = Heading("Demo mode")
mode = Badge("No AI model connected", tone="warning")
intro = Text("This server streams pre-written screens. Try one of these prompts:", tone="muted")
sep = Divider()
examples = Stack([e1, e2, e3, e4, e5], gap="sm")
e1 = Text("a payment confirmation for $42.50")
e2 = Text("a sign-in page")
e3 = Text("edit my profile")
e4 = Text("where is my order?")
e5 = Text("contact support")
failures = Text("Error demos: \"demo: unknown tool\", \"demo: missing child\", \"demo: missing mutation\", \"demo: windows path\", \"demo: cut off\", \"demo: model error\"", tone="muted")
