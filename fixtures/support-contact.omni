# Omni-IR: contact support, with subject and message sent through a governed action.
root = Card([title, intro, subject, message, actions])
title = Heading("Contact support")
intro = Text("Tell us what's going on (we reply within 1 business day).", tone="muted")
$subject = ""
subject = Input($subject, label="Subject", placeholder="e.g. Refund for order A1B2-7731")
$message = ""
message = Input($message, label="Message", placeholder="Describe the problem, what you expected, and what happened")
actions = Stack([sendTicket], direction="row")
sendTicket = Button("Send message", action="createTicket")
createTicket = McpMutation(sendTicket, tool="support.createTicket", params={subject: $subject, message: $message})
