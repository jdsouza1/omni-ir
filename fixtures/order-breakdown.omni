# Omni-IR: where this month's orders came from, as a pie chart, with the counts in a table.
root = Card([title, split, counts, download])
title = Heading("Orders by channel")
split = PieChart("Share of 1,240 orders this month", [web, app, phone, store], format="percent")
web = Slice("Website", 52)
app = Slice("App", 31)
phone = Slice("Phone", 9)
store = Slice("In store", 8)
counts = Table(["Channel", "Orders"], [r1, r2, r3, r4])
r1 = TableRow(["Website", 645])
r2 = TableRow(["App", 384])
r3 = TableRow(["Phone", 112])
r4 = TableRow(["In store", 99])
download = Button("Download as CSV", variant="secondary")
