root = Card([title, items, total, pay])
title = Heading("Your bag")
items = List([shirt, tote])
shirt = ListItem("Linen overshirt", detail="Sand · M", trailing="$128.00", image="shirt")
tote = ListItem("Canvas tote", detail="Natural", trailing="$86.00", image="tote")
total = Text(214, format="currency", currency="USD")
pay = Button("Pay securely", action="pay")
payNow = McpMutation(pay, tool="payments.confirm", params={amount: 214, note: ""})
