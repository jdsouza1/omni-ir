root = Card([title, chat, question, send])
title = Heading("Trip helper")
chat = Stack([asked, answer])
asked = Message("Any quiet beaches near Lisbon?", from="user")
answer = Message("Try Praia da Ursa. A short hike keeps the crowds away.", from="assistant")
$question = ""
question = Input($question, label="Ask a question", placeholder="Ask anything…")
send = Button("Send", action="ask")
ask = McpMutation(send, tool="assistant.ask", params={question: $question})
