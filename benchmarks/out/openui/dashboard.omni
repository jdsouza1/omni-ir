root = Stack([headerCard, kpiRow, chartsRow1, featuresCard, revenueCard], direction="column", gap="l")
headerCard = Card([header], variant="card")
header = CardHeader("Product Analytics Dashboard", subtitle="Usage, acquisition, feature adoption, and revenue trends")
kpiRow = Stack([kpi1, kpi2, kpi3, kpi4], direction="row", gap="m", align="stretch", justify="start", wrap=true)
kpi1 = Card([kpi1Title, kpi1Value, kpi1Note], variant="sunk")
kpi1Title = TextContent("Monthly Active Users (MAU)", size="small-heavy")
kpi1Value = TextContent("128,400", size="large-heavy")
kpi1Note = TextContent("+6.2% vs last month", size="small")
kpi2 = Card([kpi2Title, kpi2Value, kpi2Note], variant="sunk")
kpi2Title = TextContent("New Users (30d)", size="small-heavy")
kpi2Value = TextContent("24,950", size="large-heavy")
kpi2Note = TextContent("+3.1% vs last 30d", size="small")
kpi3 = Card([kpi3Title, kpi3Value, kpi3Note], variant="sunk")
kpi3Title = TextContent("MRR", size="small-heavy")
kpi3Value = TextContent("$412,000", size="large-heavy")
kpi3Note = TextContent("+4.4% MoM", size="small")
kpi4 = Card([kpi4Title, kpi4Value, kpi4Note], variant="sunk")
kpi4Title = TextContent("ARR", size="small-heavy")
kpi4Value = TextContent("$4.94M", size="large-heavy")
kpi4Note = TextContent("+18.7% YoY", size="small")
chartsRow1 = Stack([mauCard, acquisitionCard], direction="row", gap="l", align="stretch", justify="start", wrap=true)
mauCard = Card([mauHeader, mauChart], variant="card")
mauHeader = CardHeader("Monthly Active Users", subtitle="Last 12 months")
mauChart = BarChart(["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"], series=[mauSeries], variant="grouped", xLabel="Month", yLabel="Users")
mauSeries = Series("MAU", values=[84500, 87200, 90100, 93800, 96500, 100200, 104800, 109600, 114300, 119900, 123700, 128400])
acquisitionCard = Card([acqHeader, acqChart, acqLegendNote], variant="card")
acqHeader = CardHeader("User Acquisition", subtitle="Share of new users (last 30 days)")
acqChart = PieChart([acq1, acq2, acq3, acq4, acq5], variant="donut")
acq1 = Slice("Organic Search", value=34)
acq2 = Slice("Paid Search", value=22)
acq3 = Slice("Referrals", value=16)
acq4 = Slice("Social", value=12)
acq5 = Slice("Direct / Other", value=16)
acqLegendNote = TextContent("Tip: Track CAC and conversion rate by channel to explain mix shifts.", size="small")
featuresCard = Card([featuresHeader, featuresTable], variant="card")
featuresHeader = CardHeader("Top Features", subtitle="Adoption and engagement (last 30 days)")
featuresTable = Table([col1, col2, col3, col4], rows=[["Dashboards", 48200, 62.5, 5.8], ["Automations", 31750, 41.2, 3.1], ["Integrations", 28900, 37.5, 2.4], ["Team Collaboration", 27100, 35.2, 4.6], ["Exports", 19850, 25.8, 1.7], ["Alerts", 17600, 22.9, 2], ["API Access", 12150, 15.8, 6.3]])
col1 = Col("Feature", type="string")
col2 = Col("Weekly Active Users", type="number")
col3 = Col("Adoption Rate (%)", type="number")
col4 = Col("Avg. Uses / User", type="number")
revenueCard = Card([revenueHeader, revenueChart, revenueNote], variant="card")
revenueHeader = CardHeader("Revenue Trend", subtitle="MRR and ARR (last 12 months)")
revenueChart = LineChart(["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"], series=[mrrSeries, arrSeries], variant="natural", xLabel="Month", yLabel="USD")
mrrSeries = Series("MRR ($)", values=[332000, 341000, 349000, 356000, 364000, 372000, 381000, 389000, 397000, 404000, 408000, 412000])
arrSeries = Series("ARR ($)", values=[3984000, 4092000, 4188000, 4272000, 4368000, 4464000, 4572000, 4668000, 4764000, 4848000, 4896000, 4944000])
revenueNote = TextContent("ARR shown as 12×MRR for directional tracking; replace with contracted ARR if you track annual commitments.", size="small")
