root = Stack([title, tabs], direction="column", gap="l")
title = TextContent("User Settings", size="large-heavy")
tabs = Tabs([tabProfile, tabSecurity, tabNotifications])
tabProfile = TabItem("profile", trigger="Profile", content=[profileCard])
profileCard = Card([profileHeader, profileForm], variant="card")
profileHeader = CardHeader("Profile", subtitle="Update your personal information and avatar.")
profileForm = Form("profile_update", fields=[nameField, avatarField], buttons=profileButtons)
nameField = FormControl("Display name", input=input1)
input1 = Input("display_name", placeholder="e.g., Alex Johnson", type="text", rules=["required", "minLength:2", "maxLength:60"])
avatarField = FormControl("Avatar URL", input=input2)
input2 = Input("avatar_url", placeholder="https://example.com/avatar.png", type="url", rules=["url"])
profileButtons = Buttons([saveProfileBtn, resetProfileBtn])
saveProfileBtn = Button("Save changes", action="submit:profile_update", variant="primary")
resetProfileBtn = Button("Reset", action="action:reset_profile_form", variant="secondary")
tabSecurity = TabItem("security", trigger="Security", content=[securityCard])
securityCard = Card([securityHeader, securityToggles, securityHint], variant="card")
securityHeader = CardHeader("Security", subtitle="Manage sign-in protection and account security.")
securityToggles = SwitchGroup([twoFaSwitch], variant="sunk")
twoFaSwitch = SwitchItem("Two-factor authentication (2FA)", description="Require a verification code when signing in.", name="two_fa", value="enabled", checked=false, defaultChecked=true, disabled=false)
securityHint = TextCallout("info", title="Tip", description="After enabling 2FA, you may be asked to set up an authenticator app or backup codes.")
tabNotifications = TabItem("notifications", trigger="Notifications", content=[notificationsCard])
notificationsCard = Card([notificationsHeader, notificationsToggles], variant="card")
notificationsHeader = CardHeader("Notifications", subtitle="Choose what you want to be notified about.")
notificationsToggles = SwitchGroup([emailSwitch, productSwitch, securityAlertsSwitch], variant="sunk")
emailSwitch = SwitchItem("Email notifications", description="Receive updates and account messages by email.", name="notif_email", value="enabled", checked=true, defaultChecked=true, disabled=false)
productSwitch = SwitchItem("Product updates", description="Get notified about new features and improvements.", name="notif_product", value="enabled", checked=false, defaultChecked=false, disabled=false)
securityAlertsSwitch = SwitchItem("Security alerts", description="Important alerts about sign-ins and security changes.", name="notif_security", value="enabled", checked=true, defaultChecked=true, disabled=false)
