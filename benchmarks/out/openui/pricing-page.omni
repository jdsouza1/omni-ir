root = Stack([hero, pricingRow, tableTitle, featureTable, faq], direction="column", gap="xl")
hero = Stack([heroTitle, heroSubtitle, heroTags], direction="column", gap="s")
heroTitle = TextContent("Pricing", size="large-heavy")
heroSubtitle = TextContent("Choose the plan that fits your team today. Upgrade, downgrade, or cancel anytime.", size="default")
heroTags = TagBlock(["Monthly billing", "Annual discounts available", "No hidden fees"])
pricingRow = Stack([basicCard, proCard, enterpriseCard], direction="row", gap="l", align="stretch", justify="start", wrap=true)
basicCard = Card([basicHeader, basicPrice, basicDesc, basicFeaturesTitle, basicFeatures, basicCta], variant="card")
basicHeader = CardHeader("Basic", subtitle="For individuals and small projects")
basicPrice = TextContent("$12 / month", size="large-heavy")
basicDesc = TextContent("Core features to get started with reliable essentials.", size="default")
basicFeaturesTitle = TextContent("Includes:", size="small-heavy")
basicFeatures = MarkDownRenderer("- 1 workspace\n- Up to 3 projects\n- 5 GB storage\n- Community support\n- Basic analytics", variant="clear")
basicCta = Buttons([button1, button2])
button1 = Button("Start Basic", action="action:select_plan_basic", variant="secondary")
button2 = Button("Try free", action="action:trial_basic", variant="tertiary")
proCard = Card([proHeader, proPrice, proDesc, proFeaturesTitle, proFeatures, proCta, proCallout], variant="sunk")
proHeader = CardHeader("Pro", subtitle="For growing teams that need more power")
proPrice = TextContent("$29 / month", size="large-heavy")
proDesc = TextContent("Advanced collaboration, automation, and deeper insights.", size="default")
proFeaturesTitle = TextContent("Everything in Basic, plus:", size="small-heavy")
proFeatures = MarkDownRenderer("- 5 workspaces\n- Unlimited projects\n- 100 GB storage\n- Team roles & permissions\n- Automations (1,000 runs/month)\n- Integrations (Slack, GitHub, Zapier)\n- Priority email support", variant="clear")
proCta = Buttons([button3, button4])
button3 = Button("Choose Pro", action="action:select_plan_pro", variant="primary")
button4 = Button("Try free", action="action:trial_pro", variant="secondary")
proCallout = Callout("success", title="Most popular", description="Best value for teams that want to scale without switching tools later.")
enterpriseCard = Card([entHeader, entPrice, entDesc, entFeaturesTitle, entFeatures, entCta, entNote], variant="card")
entHeader = CardHeader("Enterprise", subtitle="For organizations with advanced security and scale")
entPrice = TextContent("Custom pricing", size="large-heavy")
entDesc = TextContent("Security, compliance, and dedicated support tailored to your needs.", size="default")
entFeaturesTitle = TextContent("Everything in Pro, plus:", size="small-heavy")
entFeatures = MarkDownRenderer("- Unlimited workspaces\n- Unlimited storage (fair use)\n- SSO/SAML & SCIM provisioning\n- Audit logs & data retention controls\n- Dedicated success manager\n- 99.9% uptime SLA\n- Custom legal & invoicing", variant="clear")
entCta = Buttons([button5, button6])
button5 = Button("Contact sales", action="action:contact_sales_enterprise", variant="primary")
button6 = Button("Request demo", action="action:request_demo_enterprise", variant="secondary")
entNote = TextCallout("neutral", title="Need procurement support?", description="We can provide security docs, vendor onboarding, and custom terms.")
tableTitle = TextContent("Feature comparison", size="large-heavy")
featureTable = Table([col1, col2, col3, col4], rows=[["Price (monthly)", "$12", "$29", "Custom"], ["Workspaces", "1", "5", "Unlimited"], ["Projects", "Up to 3", "Unlimited", "Unlimited"], ["Storage", "5 GB", "100 GB", "Unlimited (fair use)"], ["Team members", "1", "Up to 25", "Unlimited"], ["Roles & permissions", "—", "Yes", "Advanced (custom roles)"], ["Automations", "—", "1,000 runs/mo", "Unlimited (policy-based)"], ["Integrations", "Limited", "Standard", "Standard + custom"], ["Analytics", "Basic", "Advanced", "Advanced + exports"], ["SSO (SAML)", "—", "—", "Yes"], ["SCIM provisioning", "—", "—", "Yes"], ["Audit logs", "—", "—", "Yes"], ["Support", "Community", "Priority email", "Dedicated + SLA"]])
col1 = Col("Feature", type="string")
col2 = Col("Basic", type="string")
col3 = Col("Pro", type="string")
col4 = Col("Enterprise", type="string")
faq = Accordion([faq1, faq2, faq3, faq4])
faq1 = AccordionItem("billing", trigger="Can I switch plans later?", content=[textContent1])
textContent1 = TextContent("Yes. You can upgrade or downgrade at any time. Changes take effect immediately, and we prorate when applicable.")
faq2 = AccordionItem("trial", trigger="Do you offer a free trial?", content=[textContent2])
textContent2 = TextContent("Yes. Basic and Pro include a free trial. Enterprise trials are available upon request via Sales.")
faq3 = AccordionItem("annual", trigger="Do you offer annual billing?", content=[textContent3])
textContent3 = TextContent("Yes. Annual billing includes a discount. Contact Sales for Enterprise annual terms and invoicing.")
faq4 = AccordionItem("security", trigger="What about security and compliance?", content=[textContent4])
textContent4 = TextContent("Enterprise includes SSO/SAML, SCIM, audit logs, and data retention controls. We can share security documentation during procurement.")
