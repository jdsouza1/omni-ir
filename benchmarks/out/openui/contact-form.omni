root = Stack([title, form], direction="column", gap="l")
title = TextContent("Contact Us", size="large-heavy")
form = Form("contact", fields=[nameField, emailField, phoneField, subjectField, messageField], buttons=formButtons)
nameField = FormControl("Name", input=input1)
input1 = Input("name", placeholder="Your full name", type="text", rules=["required", "minLength:2"])
emailField = FormControl("Email", input=input2)
input2 = Input("email", placeholder="you@example.com", type="email", rules=["required", "email"])
phoneField = FormControl("Phone", input=input3)
input3 = Input("phone", placeholder="e.g., +1 555 123 4567", type="text", rules=["required", "minLength:7", "maxLength:20"])
subjectField = FormControl("Subject", input=select1)
select1 = Select("subject", items=[selectItem1, selectItem2, selectItem3, selectItem4, selectItem5], placeholder="Select a subject...", rules=["required"])
messageField = FormControl("Message", input=textArea1)
textArea1 = TextArea("message", placeholder="How can we help?", rows=6, rules=["required", "minLength:10"])
selectItem1 = SelectItem("general", label="General inquiry")
selectItem2 = SelectItem("support", label="Support")
selectItem3 = SelectItem("sales", label="Sales")
selectItem4 = SelectItem("billing", label="Billing")
selectItem5 = SelectItem("feedback", label="Feedback")
formButtons = Buttons([submitBtn, cancelBtn], direction="row")
submitBtn = Button("Submit", action="submit:contact", variant="primary")
cancelBtn = Button("Cancel", action="action:cancel_contact", variant="secondary")
