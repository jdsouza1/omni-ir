root = Stack([title, tbl])
title = TextContent("Employees (Sample)", size="large-heavy")
tbl = Table([col1, col2, col3, col4], rows=[["Ava Patel", "Engineering", 132000, 6.5], ["Marcus Lee", "Sales", 98000, 4.2], ["Sofia Ramirez", "Marketing", 105000, 3.1], ["Ethan Brooks", "Finance", 118500, 5], ["Nina Chen", "HR", 89000, 2.4]])
col1 = Col("Name", type="string")
col2 = Col("Department", type="string")
col3 = Col("Salary", type="number")
col4 = Col("YoY change (%)", type="number")
