root = Stack([header, main], direction="column", gap="l")
header = Card([headerText], variant="clear")
headerText = TextContent("Product Details", size="large-heavy")
main = Stack([topRow, detailsRow], direction="column", gap="l")
topRow = Stack([galleryCard, buyCard], direction="row", gap="l", align="start", justify="start", wrap=true)
galleryCard = Card([galleryHeader, gallery], variant="card")
galleryHeader = CardHeader("AeroStride Runner Sneakers", subtitle="Lightweight daily trainers with responsive cushioning")
gallery = ImageGallery([{src: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1200&q=80", alt: "Sneakers angled side view", details: "Side profile showing breathable mesh and cushioned midsole"}, {src: "https://images.unsplash.com/photo-1528701800489-20be3c1ea3b1?auto=format&fit=crop&w=1200&q=80", alt: "Sneakers top view", details: "Top view highlighting laces and padded tongue"}, {src: "https://images.unsplash.com/photo-1600269452121-4f2416e55c28?auto=format&fit=crop&w=1200&q=80", alt: "Sneakers outsole view", details: "Rubber outsole pattern for traction"}, {src: "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80", alt: "Sneakers lifestyle shot", details: "Everyday styling in an urban setting"}])
buyCard = Card([buyHeader, priceRow, separator1, sizeForm, separator2, colorCard, separator3, ctaButtons, finePrint], variant="card")
buyHeader = CardHeader("AeroStride Runner", subtitle="Men's / Women's • Road & casual")
priceRow = Stack([priceText, priceTag], direction="row", gap="m", align="center", justify="between", wrap=true)
priceText = TextContent("$129.00", size="large-heavy")
priceTag = Tag("In stock", icon="check", size="md", variant="success")
separator1 = Separator("horizontal", decorative=true)
sizeForm = Form("select_size", fields=[sizeField])
sizeField = FormControl("Size", input=select1)
select1 = Select("size", items=[selectItem1, selectItem2, selectItem3, selectItem4, selectItem5, selectItem6, selectItem7, selectItem8, selectItem9, selectItem10], placeholder="Select your size...", rules=["required"])
selectItem1 = SelectItem("7", label="US 7")
selectItem2 = SelectItem("7.5", label="US 7.5")
selectItem3 = SelectItem("8", label="US 8")
selectItem4 = SelectItem("8.5", label="US 8.5")
selectItem5 = SelectItem("9", label="US 9")
selectItem6 = SelectItem("9.5", label="US 9.5")
selectItem7 = SelectItem("10", label="US 10")
selectItem8 = SelectItem("10.5", label="US 10.5")
selectItem9 = SelectItem("11", label="US 11")
selectItem10 = SelectItem("12", label="US 12")
separator2 = Separator("horizontal", decorative=true)
colorCard = Stack([colorTitle, colorOptionsGroup], direction="column", gap="s")
colorTitle = TextContent("Color", size="small-heavy")
colorOptionsGroup = RadioGroup("color", items=[radioItem1, radioItem2, radioItem3], defaultValue="black_white", rules=["required"])
radioItem1 = RadioItem("Black / White", description="Classic contrast with white midsole", value="black_white")
radioItem2 = RadioItem("Sand / Gum", description="Neutral upper with gum outsole", value="sand_gum")
radioItem3 = RadioItem("Slate / Neon", description="Cool tones with neon accents", value="slate_neon")
separator3 = Separator("horizontal", decorative=true)
ctaButtons = Buttons([addToCartBtn, wishlistBtn], direction="row")
addToCartBtn = Button("Add to Cart", action="action:add_to_cart_sneakers", variant="primary")
wishlistBtn = Button("Save", action="action:save_sneakers", variant="secondary")
finePrint = TextContent("Free returns within 30 days. Ships in 1–2 business days.", size="small")
detailsRow = Stack([detailsCard, specsCard], direction="row", gap="l", align="start", justify="start", wrap=true)
detailsCard = Card([detailsHeader, detailsText, featureTags], variant="sunk")
detailsHeader = CardHeader("About this item", subtitle="Built for comfort from morning commutes to weekend miles")
detailsText = MarkDownRenderer("The **AeroStride Runner** blends breathable mesh with a supportive heel counter for a secure fit. A responsive foam midsole delivers soft landings and quick transitions, while the durable rubber outsole adds traction on city streets.\n\n**Fit note:** True to size. If you’re between sizes, consider going up 0.5.", variant="clear")
featureTags = TagBlock(["Breathable mesh upper", "Responsive foam cushioning", "Rubber traction outsole", "Padded collar & tongue", "Everyday training"])
specsCard = Card([specsHeader, specsTable], variant="sunk")
specsHeader = CardHeader("Specs", subtitle="Materials, weight, and care")
specsTable = Table([col1, col2], rows=[["Weight", "9.8 oz (US 9)"], ["Drop", "8 mm"], ["Upper", "Engineered mesh"], ["Midsole", "EVA-based foam"], ["Outsole", "High-abrasion rubber"], ["Care", "Spot clean; air dry"]])
col1 = Col("Detail", type="string")
col2 = Col("Value", type="string")
