root = Stack([header, layout], direction="column", gap="l")
header = TextContent("Revenue Dashboard", size="large-heavy")
layout = Stack([metricCard, chartCard], direction="row", gap="l", align="stretch", justify="start", wrap=true)
metricCard = Card([metricHeader, metricValue, metricDelta], variant="card")
metricHeader = CardHeader("Total Revenue", subtitle="Last 6 months")
metricValue = TextContent("$1,284,000", size="large-heavy")
metricDelta = TextCallout("success", title="Up 8.4%", description="Compared to the previous 6 months")
chartCard = Card([chartHeader, revenueChart], variant="card")
chartHeader = CardHeader("Monthly Revenue", subtitle="Last 6 months")
revenueChart = BarChart(["Oct", "Nov", "Dec", "Jan", "Feb", "Mar"], series=[revenueSeries], variant="grouped", xLabel="Month", yLabel="Revenue (USD)")
revenueSeries = Series("Revenue", values=[198000, 205000, 214000, 210000, 223000, 234000])
