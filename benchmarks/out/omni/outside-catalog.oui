root = Card([video, header, progress, sep, controls])
video = Skeleton(6)
header = Stack([title, status], "row", "sm", "center")
title = Heading("Video", 2)
status = Badge("Paused", "neutral")
progress = Stack([elapsed, divider, duration], "row", "sm", "center")
elapsed = Text("0:00", null, null, "strong")
divider = Text("/", null, null, "muted")
duration = Text("3:42", null, null, "muted")
sep = Divider()
controls = Stack([back, play, forward], "row", "sm", "center")
back = Button("Back 10s", null, "secondary")
play = Button("Play", null, "primary")
forward = Button("Forward 10s", null, "secondary")
