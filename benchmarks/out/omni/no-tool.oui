root = Card([title, profileSection, deleteSection])
title = Heading("Settings", 1)
profileSection = Card([displayName, bio, saveRow], "Profile")
$displayName = ""
displayName = Input($displayName, "Display name", "Your name")
$bio = ""
bio = Input($bio, "Bio", "A short line about you (160 characters max)")
saveRow = Stack([save], "row")
save = Button("Save changes", Action([@Run(saveProfile)]), "primary")
saveProfile = Mutation("profile.update", {displayName: $displayName, bio: $bio})
deleteSection = Card([deleteHeader, deleteWarning, deleteInfo, deleteRow], "Danger zone")
deleteHeader = Stack([deleteTitle, deleteBadge], "row", "sm", "center")
deleteTitle = Heading("Delete account", 3)
deleteBadge = Badge("Permanent", "danger")
deleteWarning = Text("Deleting your account permanently removes your profile, orders and bookings. This can't be undone.", null, null, "strong")
deleteInfo = Text("Your request goes to our support team, who will confirm by email before the account is deleted.", null, null, "muted")
deleteRow = Stack([deleteBtn], "row")
deleteBtn = Button("Request account deletion", Action([@Run(requestDeletion)]), "danger")
requestDeletion = Mutation("support.createTicket", {subject: "Account deletion request", message: "Please permanently delete my account and all associated data."})
