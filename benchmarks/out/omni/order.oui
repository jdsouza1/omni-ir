root = Card([header, items, carrier, etaRow, sep, actions])
header = Stack([title, status], "row", "sm", "center")
title = Heading("Order #A1B2-7731", 1)
status = Badge("Shipped", "success")
items = Text("2 items: Linen shirt, Canvas tote")
carrier = Text("Carrier: Parcelwise, tracking 1Z-88-4410", null, null, "muted")
etaRow = Stack([etaLabel, eta], "row", "sm", "center")
etaLabel = Text("Estimated delivery", null, null, "muted")
eta = Text("2026-10-03", "date", null, "strong")
sep = Divider()
actions = Stack([returnItem, help], "row", "sm")
returnItem = Button("Request a return", Action([@Run(requestReturn)]), "secondary")
requestReturn = Mutation("orders.requestReturn", {orderId: "A1B2-7731"})
help = Button("Contact support", null, "secondary")
