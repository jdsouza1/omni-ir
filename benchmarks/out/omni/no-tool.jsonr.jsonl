{"op":"add","path":"/root","value":"root"}
{"op":"add","path":"/elements/root","value":{"type":"Card","props":{},"children":["title","profileSection","deleteSection"]}}
{"op":"add","path":"/elements/title","value":{"type":"Heading","props":{"text":"Settings","level":1},"children":[]}}
