{"op":"add","path":"/state/bio","value":""}
{"op":"add","path":"/elements/bio","value":{"type":"Input","props":{"value":{"$bindState":"/bio"},"label":"Bio","placeholder":"A short line about you (160 characters max)"},"children":[]}}
